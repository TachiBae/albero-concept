---
import Photo from './Photo.astro';
import Todo from './Todo.astro';
import { bookVisit, contact, heading, pages, stripColon } from './lib/content';

const title = stripColon(heading(pages.visit, /^BOOK your visit/)!);
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(contact.address)}`;
---

<!-- Contained, photo left: Custom (next section) runs text left / photos right, so this one mirrors it. -->
<section id="visit" aria-labelledby="visit-title" class="bg-paper py-24 md:py-32" data-visit>
  <div class="container-page grid gap-12 md:grid-cols-12 md:items-center md:gap-8">
    <Photo
      src="/images/with-fp/ABR_6148.jpg"
      alt="A cream upholstered lounge chair on pale wood legs in soft daylight, a person walking past behind it"
      class="aspect-[4/5] w-full object-cover md:col-span-5"
      sizes="(min-width: 768px) 40vw, 100vw"
    />

    <div class="md:col-span-6 md:col-start-7">
      <h2 id="visit-title" class="display-lg">{title}</h2>
      <div class="mt-8 h-px w-14 bg-espresso/40"></div>

      <dl class="mt-10 grid gap-x-12 gap-y-8 text-[16px] leading-relaxed sm:grid-cols-[3fr_2fr]">
        <div>
          <dt class="caps">{contact.hqLabel}</dt>
          <dd class="mt-2 space-y-1 text-ink-soft">
            <a href={mapsHref} class="block underline decoration-line underline-offset-4 hover:decoration-current">{contact.address}</a>
            <a href={`mailto:${contact.email}`} class="block pt-3 underline decoration-line underline-offset-4 hover:decoration-current">{contact.email}</a>
            <a href={`tel:${contact.phone.replace(/\s/g, '')}`} class="block underline decoration-line underline-offset-4 hover:decoration-current">{contact.phone}</a>
          </dd>
        </div>

        <div>
          <dt class="caps">{contact.hoursLabel}</dt>
          <dd class="mt-2"><Todo /></dd>
        </div>
      </dl>

      <a href={bookVisit.href} class="btn-dark mt-12 w-full sm:w-auto">{bookVisit.text}</a>
    </div>
  </div>
</section>
