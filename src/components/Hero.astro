---
// Curved carousel hero (CLAUDE.md "Hero carousel", replaces the scroll scrub):
// the tagline and Book Your Visit centred on top, then a ribbon of Albero room
// photos on the inside of a cylinder. Centre cards sit farther away, edge cards
// come closer, so the ribbon's top and bottom edges bow toward the middle.
// Without JS the same curve renders statically from CSS.
import Photo from './Photo.astro';
import { bookVisit, pages, quote } from './lib/content';

const headline = quote(pages.home, 'CREATED FOR YOUR LIFE/STYLE');
const subline = quote(pages.home, 'We see each space and furniture');

// Landscape room shots only. The inventory has no alt text for these files ("—"), so each describes the photo itself.
const rooms = [
  {
    src: '/images/home/ABR_2282.jpg',
    alt: 'A Cere Collection living room: tan sofa with cream cushions behind a grey wood coffee table with a stone top',
  },
  {
    src: '/images/2ndhaus-collection/2NDHAUS-75325-EDIT.jpg',
    alt: 'Round dark wood dining table on an arched base between two cream armchairs, in front of a curtained window',
  },
  {
    src: '/images/insilence-collection/CALBEROPIFS25INSILENCE-4041-EDIT.jpg',
    alt: 'Two people on a white sectional sofa beside an oval coffee table, beneath a white staircase',
  },
  {
    src: '/images/our-story/Albero---Y-gen-Collection.jpg',
    alt: 'A person seated on a low sofa beside a round glass coffee table, with a circular window screen behind',
  },
  {
    src: '/images/amust-collection/AMUST_24-8736.jpg',
    alt: 'Long dining table with upholstered chairs beneath a floating staircase',
  },
  {
    src: '/images/home-2nd-haus/2NDHAUS-74810-EDIT.jpg',
    alt: 'A bedroom with a brown upholstered bed under tall curtained windows, a slatted coffee table and lounge chair in front',
  },
  {
    src: '/images/cere-collection/ABR_0067.jpg',
    alt: 'A Cere Collection living room: tan sofa, dark coffee table with a stone top, and a burl wood cabinet with arched glass doors',
  },
  {
    src: '/images/about/ORIGIN-38-6540-EDIT.jpg',
    alt: 'An open timber gable frame holding a pale upholstered chair and a low table, flanked by shelves of potted flowers',
  },
  {
    src: '/images/close-collection/image-asset.jpeg',
    alt: 'Two people relaxing in a bedroom with an upholstered bed, floor cushions and a tall shelf',
  },
  {
    src: '/images/hygge-collection/ALBERO_PIFS2020-6413.jpg',
    alt: 'A pale sofa and a wood coffee table on a curved base, in front of a round window hung with a brown curtain',
  },
  {
    src: '/images/insilence-collection/CALBEROPIFS25INSILENCE-4382-EDIT.jpg',
    alt: 'Two people seated at a round table with a marble top',
  },
  {
    src: '/images/alberoathome-ley/LANCE_LEY-71.jpg',
    alt: 'Two people in a bedroom with a peach upholstered headboard and glowing globe lamps',
  },
];

// Geometry shared with the script: STEP degrees between cards (the CSS uses sin(STEP / 2)), cards past LIMIT are hidden.
const STEP = 24;
const LIMIT = 80;
const span = STEP * rooms.length;
const wrap = (a: number) => ((((a + span / 2) % span) + span) % span) - span / 2;
---

<!-- Below md the fixed Book Your Visit bar (56px) covers the bottom of the viewport, so the ribbon stops above it. -->
<section
  id="hero"
  class="flex flex-col overflow-hidden pt-[6vh] pb-16 md:pt-[5vh] md:pb-4"
  style="min-height: calc(100svh - var(--header-h))"
  data-hero
>
  <div class="container-page flex flex-col items-center text-center">
    <h1 class="display-xl max-w-[20ch]">{headline}</h1>
    <p class="mt-4 max-w-[58ch] text-[16px] leading-relaxed text-espresso/85">{subline}</p>
    <a href={bookVisit.href} class="btn-dark mt-6">{bookVisit.text}</a>
  </div>

  <!-- The ribbon takes whatever height is left, so spare space centres the cards instead of leaving a gap above them. -->
  <div class="relative mt-4 flex flex-1 flex-col">
    <ul class="ribbon flex-1" data-ribbon>
      {
        rooms.map((room, i) => {
          const a = wrap(i * STEP);
          return (
            <li class="card bg-paper-deep" style={`--a: ${a}`} hidden={Math.abs(a) > LIMIT} data-card>
              <Photo
                src={room.src}
                alt={room.alt}
                class="h-full w-full object-cover"
                loading={Math.abs(a) <= 2 * STEP ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
                sizes="(min-width: 768px) 34vw, 85vw"
              />
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .ribbon {
    /* Card size caps on the viewport height too, so the ribbon still fits under the headline on short laptops. */
    --card-w: clamp(240px, min(30vw, 100svh - 23rem), 520px);
    --card-h: calc(var(--card-w) * 2 / 3);
    /* Radius that spaces cards STEP (24deg) apart with a 6% gap: chord = 2R sin(12deg). */
    --r: calc(var(--card-w) * 1.06 / (2 * sin(12deg)));
    position: relative;
    min-height: calc(var(--card-h) * 1.35); /* room for the closest visible edge card's scale */
    perspective: calc(var(--r) * 1.4);
    cursor: grab;
    touch-action: pan-y; /* the browser keeps vertical scrolling; only horizontal swipes reach the drag */
    user-select: none;
    -webkit-user-select: none;
  }

  @media (max-width: 767px) {
    .ribbon {
      --card-w: 70vw;
    }
  }

  .ribbon[data-dragging] {
    cursor: grabbing;
  }

  .card {
    position: absolute;
    left: calc(50% - var(--card-w) / 2);
    top: calc(50% - var(--card-h) / 2);
    width: var(--card-w);
    height: var(--card-h);
    overflow: hidden;
    backface-visibility: hidden;
    /* Static pose (no JS, and before the script runs); the script then writes transform directly. */
    transform: translateZ(var(--r)) rotateY(calc(var(--a) * -1deg)) translateZ(calc(var(--r) * -1));
  }

  .card[hidden] {
    display: block;
    visibility: hidden;
  }

  .card :global(img) {
    pointer-events: none;
    -webkit-user-drag: none;
  }
</style>

<script>
  const STEP = 24; // degrees between cards; keep in sync with the frontmatter and sin(12deg) in the CSS
  const LIMIT = 80; // cards beyond this angle are off-screen or near the camera: hide them
  const AUTO = STEP / 3500; // deg per ms: one card every 3.5 s
  const SETTLE = 700; // ms time constant for released momentum easing back into the auto-scroll
  const MAX_V = 0.4; // deg per ms cap on a flick
  const DEG = 180 / Math.PI;

  const section = document.querySelector<HTMLElement>('[data-hero]');
  const ribbon = section?.querySelector<HTMLElement>('[data-ribbon]');

  if (section && ribbon) {
    const cards = [...ribbon.querySelectorAll<HTMLElement>('[data-card]')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const span = STEP * cards.length;
    const wrap = (a: number) => ((((a + span / 2) % span) + span) % span) - span / 2;

    let radius = 0;
    let offset = 0; // degrees the ribbon has travelled
    let v = 0; // deg per ms
    let onscreen = true;
    let raf = 0;
    let last = 0;
    let drag: { id: number; x: number; t: number } | null = null;

    const measure = () => {
      radius = (cards[0].offsetWidth * 1.06) / (2 * Math.sin(STEP / 2 / DEG));
    };

    const render = () => {
      cards.forEach((card, i) => {
        const a = wrap(i * STEP - offset);
        const off = Math.abs(a) > LIMIT;
        if (card.hidden !== off) card.hidden = off;
        if (!off) card.style.transform = `translateZ(${radius}px) rotateY(${-a}deg) translateZ(${-radius}px)`;
      });
    };

    const target = () => (reduce.matches ? 0 : AUTO);

    const frame = (t: number) => {
      const dt = last ? Math.min(t - last, 64) : 0; // clamp so a stalled tab doesn't jump the ribbon
      last = t;
      if (!drag) {
        v += (target() - v) * (1 - Math.exp(-dt / SETTLE));
        offset += v * dt;
      }
      render();
      // Keep going while it auto-scrolls or coasts; a stopped ribbon (reduced motion) idles until the next drag.
      raf = onscreen && !document.hidden && (drag || target() || Math.abs(v) > 1e-5) ? requestAnimationFrame(frame) : 0;
      if (!raf) last = 0;
    };

    const kick = () => {
      if (!raf && onscreen && !document.hidden) raf = requestAnimationFrame(frame);
    };

    const stop = () => {
      cancelAnimationFrame(raf);
      raf = 0;
      last = 0;
    };

    ribbon.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      drag = { id: e.pointerId, x: e.clientX, t: e.timeStamp };
      v = 0;
      ribbon.setPointerCapture(e.pointerId);
      ribbon.dataset.dragging = '';
      kick();
    });

    ribbon.addEventListener('pointermove', (e) => {
      if (drag?.id !== e.pointerId) return;
      const delta = (-(e.clientX - drag.x) / radius) * DEG; // dragging right moves the ribbon right
      const dt = e.timeStamp - drag.t;
      offset += delta;
      if (dt > 0) v = v * 0.6 + (delta / dt) * 0.4; // smoothed, so the release carries the flick and not one noisy sample
      drag.x = e.clientX;
      drag.t = e.timeStamp;
    });

    const release = (e: PointerEvent) => {
      if (drag?.id !== e.pointerId) return;
      const held = e.timeStamp - drag.t > 80; // stopped moving before letting go: no flick
      v = reduce.matches || held ? 0 : Math.max(-MAX_V, Math.min(MAX_V, v));
      drag = null;
      delete ribbon.dataset.dragging;
      kick();
    };
    ribbon.addEventListener('pointerup', release);
    ribbon.addEventListener('pointercancel', release); // e.g. the browser took over for a vertical scroll

    reduce.addEventListener('change', () => {
      v = 0;
      kick();
    });

    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : kick()));

    new IntersectionObserver(([entry]) => {
      onscreen = entry.isIntersecting;
      onscreen ? kick() : stop();
    }).observe(section);

    new ResizeObserver(() => {
      measure();
      render();
    }).observe(ribbon);

    // Cards rotate in from hidden, so lazy loading alone would show them blank: fetch the rest once the page has loaded.
    const preload = () => ribbon.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((img) => (img.loading = 'eager'));
    document.readyState === 'complete' ? preload() : addEventListener('load', preload, { once: true });

    measure();
    v = target();
    render();
    kick();
  }
</script>
