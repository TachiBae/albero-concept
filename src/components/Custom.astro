---
import Photo from './Photo.astro';
import { button, firstSentence, heading, pages, quote } from './lib/content';

const title = heading(pages.custom, /^CUSTOM FURNITURE$/)!;
const paragraphs = [
  quote(pages.home, 'We see each space and furniture'),
  firstSentence(quote(pages.custom, 'All Albero pieces may be customized')),
];
const materials = {
  title: heading(pages.ourStory, /^MATERIALS$/)!,
  text: quote(pages.ourStory, 'Wood is a living element').match(/^(.*?\.\s.*?\.)(\s|$)/)?.[1] ?? '',
};
const customize = button(pages.custom, 'Customize Your Own');
const consult = button(pages.cere, 'Schedule a Design Consultation');

// The custom-furniture gallery images aren't readable on disk (see the build
// report), so this pair comes from other Albero pages.
const images = [
  { src: '/images/hygge-collection/ALBERO_PIFS2020-6513-2.jpg', alt: 'Wood side table with a woven magazine rack beside an upholstered armchair' },
  { src: '/images/origin-collection/DisplayShelf_04.jpg', alt: 'Display shelf with sculpted wood uprights and pale shelves above a wood cabinet' },
];
---

<section aria-labelledby="custom-title" class="py-24 md:py-40">
  <div class="container-page grid gap-14 md:grid-cols-12 md:gap-8">
    <div class="md:col-span-5 md:self-center lg:col-span-4">
      <h2 id="custom-title" class="display-lg">{title}</h2>
      <div class="mt-8 h-px w-14 bg-espresso/40"></div>
      <div class="mt-8 max-w-[42ch] space-y-5 text-[15px] leading-relaxed text-ink-soft">
        {paragraphs.map((p) => <p>{p}</p>)}
      </div>

      <div class="mt-10 border-t border-line pt-6">
        <h3 class="caps text-[11px]">{materials.title}</h3>
        <p class="mt-3 max-w-[42ch] text-[14px] leading-relaxed text-ink-soft">{materials.text}</p>
      </div>

      <div class="mt-10 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-8">
        <a href={customize.href} class="btn-dark">{customize.text}</a>
        <a href={consult.href} class="link-arrow">
          {consult.text}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-3 md:col-span-6 md:col-start-7 md:gap-5">
      {images.map((img, i) => <Photo {...img} class:list={['aspect-[2/3] w-full object-cover', i === 1 && 'md:mt-16']} sizes="(min-width: 768px) 25vw, 50vw" />)}
    </div>
  </div>
</section>
