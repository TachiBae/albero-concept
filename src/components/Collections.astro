---
// The only place all nine collections appear together: albero.ph has no
// collections index (/Collections redirects to /cere-collection).
import Photo from './Photo.astro';
import { collections, primaryNav } from './lib/content';

const title = primaryNav[0].text; // "Collections" (site.json nav)
---

<section id="collections" aria-labelledby="collections-title" class="py-24 md:py-40">
  <div class="container-page">
    <h2 id="collections-title" class="display-lg">{title}</h2>

    <ul class="mt-12 grid grid-cols-2 gap-x-3 gap-y-10 md:mt-16 md:grid-cols-3 md:gap-x-8 md:gap-y-20">
      {
        collections.map((c, i) => (
          // On mobile the 9th card spans both columns.
          <li class:list={[i === collections.length - 1 && 'col-span-2 md:col-span-1']}>
            <a href={c.href} class="group block">
              <div class="overflow-hidden">
                <Photo
                  src={c.image}
                  alt={c.alt}
                  class:list={[
                    'w-full object-cover',
                    i === collections.length - 1 ? 'aspect-[16/9] md:aspect-[5/4]' : 'aspect-[4/5] md:aspect-[5/4]',
                  ]}
                  sizes="(min-width: 768px) 30vw, 50vw"
                />
              </div>
              <p class="title mt-4 md:mt-5 md:text-center">
                <span class="group-hover:underline group-hover:underline-offset-4">{c.name}</span>
              </p>
              {c.meta && <p class="mt-1.5 text-[14px] text-ink-soft md:text-center">{c.meta}</p>}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
