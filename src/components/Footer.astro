---
import Todo from './Todo.astro';
import {
  bookVisit,
  collectionLinks,
  contact,
  customLink,
  homesLinks,
  inquire,
  ourStory,
  primaryNav,
  shopLinks,
  social,
  wordmark,
} from './lib/content';

const label = (text: string) => primaryNav.find((n) => n.text === text)!.text;

// Only routes that exist on albero.ph (and so in this concept's sitemap).
const columns = [
  { title: label('Collections'), links: collectionLinks },
  { title: label('Shop'), links: shopLinks },
  { title: label('Homes'), links: homesLinks },
  { title: label('About'), links: [ourStory, customLink, inquire, bookVisit] },
];

const year = new Date().getFullYear();
const copyright = contact.copyright.replace('©', `© ${year}`);

const icons: Record<string, string> = {
  facebook: 'M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H7.9v3h2.6V21',
  instagram: 'M7.5 3h9A4.5 4.5 0 0 1 21 7.5v9a4.5 4.5 0 0 1-4.5 4.5h-9A4.5 4.5 0 0 1 3 16.5v-9A4.5 4.5 0 0 1 7.5 3Zm4.5 5a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm5.2-1.6h.01',
  youtube: 'M21 8.2c-.2-1.4-1-2.4-2.4-2.5C16.7 5.5 14.4 5.4 12 5.4s-4.7.1-6.6.3C4 5.8 3.2 6.8 3 8.2a24 24 0 0 0 0 7.6c.2 1.4 1 2.4 2.4 2.5 1.9.2 4.2.3 6.6.3s4.7-.1 6.6-.3c1.4-.1 2.2-1.1 2.4-2.5a24 24 0 0 0 0-7.6ZM10 15V9l5.2 3-5.2 3Z',
};
---

<footer class="bg-paper-deep pt-20 pb-10 md:pt-28">
  <div class="container-page">
    <div class="grid gap-12 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-4">
        <a href="/" class="font-display text-[26px] leading-none tracking-[0.3em]">{wordmark}</a>
        <ul class="mt-8 space-y-2 text-[14px] text-ink-soft">
          <li><a href={`mailto:${contact.footerEmail}`} class="hover:text-espresso">{contact.footerEmail}</a></li>
          <li>{contact.footerLine}</li>
          <li class="flex flex-wrap items-center gap-2 pt-1">
            <span>{contact.hoursLabel}</span>
            <Todo />
          </li>
        </ul>
        <ul class="mt-8 flex gap-2">
          {
            social.map((s) => (
              <li>
                <a href={s.href} aria-label={s.text} class="-ml-2.5 grid h-11 w-11 place-items-center text-ink-soft hover:text-espresso">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true">
                    <path d={icons[s.text]} />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-4 md:col-span-8">
        {
          columns.map((col) => (
            <nav aria-label={col.title}>
              <h2 class="caps text-[11px]">{col.title}</h2>
              <ul class="mt-5 space-y-1">
                {col.links.map((l) => (
                  <li>
                    <a href={l.href} class="inline-flex min-h-[32px] items-center text-[14px] text-ink-soft hover:text-espresso">
                      {l.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-2 border-t border-line pt-6 text-[12px] text-ink-soft md:flex-row md:justify-between">
      <p>{copyright}</p>
      <p>Unofficial concept — content and photos © Albero</p>
    </div>
  </div>
</footer>
