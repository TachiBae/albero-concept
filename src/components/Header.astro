---
import Photo from './Photo.astro';
import { bookVisit, primaryNav, wordmark } from './lib/content';
---

<header class="sticky top-0 z-50 border-b border-line bg-paper" style="height: var(--header-h)">
  <div class="container-page flex h-full items-center justify-between">
    <a href="/" class="flex min-h-[44px] items-center" aria-label={`${wordmark}, home`}>
      <!-- Albero's own wordmark, from the albero.ph header. -->
      <Photo src="/images/site/albero-wordmark.png" alt="" class="h-4 w-auto md:h-[18px]" loading="eager" sizes="140px" />
    </a>

    <div class="flex items-center gap-4 lg:gap-12">
      <!-- Full nav only from lg: at 768–1023 the five tracked links plus the button overflowed the header. -->
      <nav aria-label="Primary" class="hidden lg:block">
        <ul class="flex items-center gap-9">
          {
            primaryNav.map((item) => (
              <li>
                <a href={item.href} class="caps inline-flex min-h-[44px] items-center hover:text-burl-ink">
                  {item.text}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <!-- Outline, so the hero's DISCOVER CERE (goal 1) leads; below md the mobile bar carries this link. -->
      <a href={bookVisit.href} class="btn-outline hidden md:inline-flex">{bookVisit.text}</a>

      <button
        type="button"
        class="-mr-2 grid h-11 w-11 place-items-center lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Menu"
        data-menu-toggle
      >
        <svg width="22" height="14" viewBox="0 0 22 14" fill="none" aria-hidden="true">
          <path d="M0 1h22M0 7h22M0 13h22" stroke="currentColor" stroke-width="1.25"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label="Primary" class="border-b border-line bg-paper lg:hidden" hidden>
    <ul class="container-page py-4">
      {
        primaryNav.map((item) => (
          <li class="border-b border-line last:border-0">
            <a href={item.href} class="caps flex min-h-[52px] items-center">
              {item.text}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
    };

    toggle.addEventListener('click', () => setOpen(menu.hidden));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
    // Tabbing out of the open menu left it covering the page; close it when focus moves elsewhere (not to the toggle).
    menu.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (next && next !== toggle && !menu.contains(next)) setOpen(false);
    });
  }
</script>
