---
import BaseLayout from '../components/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CereStory from '../components/CereStory.astro';
import Collections from '../components/Collections.astro';
import Visit from '../components/Visit.astro';
import Custom from '../components/Custom.astro';
import Footer from '../components/Footer.astro';
import MobileVisitBar from '../components/MobileVisitBar.astro';
import { firstSentence, pages, wordmark } from '../components/lib/content';

const description = firstSentence(pages.storeHome.meta_description ?? '');
---

<BaseLayout title={`${wordmark} (unofficial concept)`} description={description}>
  <link slot="head" rel="preload" as="image" href="/images/cere-collection/ABR_0067.jpg" fetchpriority="high" />
  <Header />
  <main>
    <Hero />
    <CereStory />
    <Collections />
    <Visit />
    <Custom />
  </main>
  <Footer />
  <MobileVisitBar />
</BaseLayout>
