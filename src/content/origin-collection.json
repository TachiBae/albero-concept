      "blocks": [
        {
          "type": "text",
          "items": [
            {
              "tag": "h1",
              "text": "ORIGIN"
            },
            {
              "tag": "h2",
              "text": "2023 Collection"
            },
            {
              "tag": "p",
              "text": "Introducing a bold and authentic furniture collection that captures the essence of raw beauty. Each piece in this organic collection is a unique representation of the Albero’s identity, redefined to reflect its natural character and artistic flair."
            }
          ]
        },
        {
          "type": "image-classic",
          "image": "/images/origin-collection/ORIGIN-52-6138-EDIT.jpg",
          "alt": "",
          "caption": "",
          "link": null
        },
        {
          "type": "text",
          "items": [
            {
              "tag": "p",
              "text": "From the warm glow of the polished wood to the earthy richness of the textured surfaces, this collection invites you to reconnect with nature and embrace the beauty of the raw and organic. With a focus on redefining the brand’s style and character, this collection is a testament to the power of natural beauty and authentic design."
            },
            {
              "tag": "p",
              "text": "View the collection film here:"
            }
          ]
        },
        {
          "type": "video",
          "url": "https://www.youtube.com/embed/oLFnHFbife0?feature=oembed",
          "title": "ORIGIN Collection | ALBERO",
          "provider": "YouTube",
          "description": null,
          "thumbnail": null
        },
        {
          "type": "text",
          "items": [
            {
              "tag": "p",
              "text": "Presenting Origin –"
            }
