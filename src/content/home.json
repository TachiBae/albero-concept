        },
        {
          "type": "text",
          "items": [
            {
              "tag": "h3",
              "text": "CREATED FOR YOUR LIFE/STYLE"
            },
            {
              "tag": "p",
              "text": "We see each space and furniture that we create as a personal statement that dovetails a shared vision and desired élan."
            },
            {
              "tag": "p",
              "text": "Customized pieces are an essential design element to any space. Establish a sense of harmony and order with furniture crafted with your needs in mind."
            }
          ]
        },
        {
          "type": "button",
          "text": "CUSTOMIZE WITH ALBERO",
          "href": "https://albero.ph/custom-furniture"
        }
      ]
    }
