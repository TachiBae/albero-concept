              "text": "Hygge Collection"
            }
          ]
        },
        {
          "type": "video",
          "url": "//www.youtube.com/embed/4KCgAShBp-8?wmode=opaque&enablejsapi=1",
          "title": null,
          "provider": "YouTube",
