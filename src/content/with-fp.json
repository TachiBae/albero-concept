        },
        {
          "type": "text",
          "items": [
            {
              "tag": "p",
              "text": "The space draws from the bespoke nature of the FP brand, with refined craftsmanship, structured silhouettes, and an understated elegance. “"
            },
            {
              "tag": "h2",
              "text": "FP in His Albero home"
            }
          ]
        },
